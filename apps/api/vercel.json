{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/health(?:/(?:ready|ledger))?$", "dest": "/api/index.ts" },
    { "src": "/metrics", "dest": "/api/index.ts" },
    { "src": "/v1/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ]
}
