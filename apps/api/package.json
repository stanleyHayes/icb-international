{
  "name": "@icb/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "node --env-file=../../.env --watch dist/main.js",
    "start": "node --env-file=../../.env dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config test/security/vitest.config.ts",
    "seed": "node --env-file=../../.env dist/simulation/seed/seed.cli.js",
    "db:reset": "node --env-file=../../.env dist/simulation/seed/seed.cli.js --reset",
    "verify:ledger": "node --env-file=../../.env dist/simulation/seed/verify-ledger.cli.js",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/websocket": "^11.3.0",
    "@icb/contracts": "workspace:*",
    "@icb/media": "workspace:*",
    "@icb/money": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "argon2": "0.45.1",
    "cloudinary": "2.10.0",
    "fastify": "5.11.0",
    "mongoose": "9.9.1",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "resend": "6.18.1",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@icb/config-eslint": "workspace:*",
    "@icb/config-ts": "workspace:*",
    "@icb/testing": "workspace:*",
    "@nestjs/cli": "11.0.13",
    "@nestjs/testing": "11.1.28",
    "@types/node": "26.1.2",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "supertest": "7.2.2",
    "tsx": "4.19.2",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
