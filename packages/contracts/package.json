{
  "name": "@icb/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "pnpm --filter @icb/money build && tsx scripts/build-openapi.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@icb/money": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@icb/config-eslint": "workspace:*",
    "@icb/config-ts": "workspace:*",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tsx": "4.19.2",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "zod-openapi": "^6.0.0"
  }
}
