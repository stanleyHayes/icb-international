{
  "name": "icb",
  "version": "1.0.0",
  "private": true,
  "description": "ICB \u2014 International Commercial Bank. A full-fidelity banking simulation.",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:contract": "pnpm --filter @icb/api test:contract",
    "test:integration": "pnpm --filter @icb/api test:integration",
    "test:security": "pnpm --filter @icb/api test:security",
    "test:a11y": "playwright test --config e2e/a11y/playwright.config.ts",
    "verify": "turbo run lint typecheck test build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "verify:infra": "node tools/scripts/verify-infra.mjs",
    "contracts:openapi": "pnpm --filter @icb/contracts openapi",
    "seed": "pnpm --filter @icb/api seed",
    "verify:ledger": "pnpm --filter @icb/api verify:ledger",
    "db:reset": "pnpm --filter @icb/api db:reset",
    "provision:console": "pnpm --filter @icb/api provision:console",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@icb/config-eslint": "workspace:*",
    "@icb/config-ts": "workspace:*",
    "@types/node": "^26.1.2",
    "mongodb": "^7.5.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "always"
  }
}
